# Government Scheme Finder (MITRA AI) - Environment Configuration
# ====================================================================

# 1. Google Gemini AI API Configuration (Optional)
# Obtain a free API key at: https://aistudio.google.com/app/apikey
# When configured, Mitra AI uses Google Gemini to generate dynamic natural responses.
# When not configured, Mitra AI uses the built-in deterministic, context-aware rule engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. OpenAI API Configuration (Alternative, Optional)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# 3. Flask Server Configuration
FLASK_PORT=5000
FLASK_DEBUG=false
